# ─── Environment ─────────────────────────────────────────────────────────────
# TESTNET=true  → Binance Spot Testnet (https://testnet.binance.vision) — DEFAULT
# TESTNET=false → LIVE trading with real funds. Flip this only deliberately,
#                 after reading the go-live checklist in README.md.
TESTNET=true

# ─── API keys ────────────────────────────────────────────────────────────────
# Testnet keys: create at https://testnet.binance.vision (log in with GitHub).
# Live keys:    create with TRADING ENABLED, WITHDRAWALS DISABLED, and IP
#               whitelisting. See README.md § "Creating restricted API keys".
# SECURITY (this machine): per purocoach-incident-2026-08-06.md, do NOT place
# live API keys on this host until it has been reinstalled. Testnet keys only.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─── Server ──────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ─── Dashboard login (single user) ───────────────────────────────────────────
# Used ONLY on first boot to create the login record. If AUTH_PASSWORD is left
# empty, a random password is generated and printed to the console once.
# Afterwards, credentials are changed from the dashboard's Settings page.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# ─── Storage / logging ───────────────────────────────────────────────────────
DB_PATH=data/bot.db
LOG_LEVEL=INFO

# ─── Optional alerting (fills, stop-losses, kill-switch events) ──────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
