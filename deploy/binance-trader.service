[Unit]
Description=Binance Trader backend (isolated from purocoach)
After=network-online.target
Wants=network-online.target

[Service]
User=botrunner
Group=botrunner
WorkingDirectory=/opt/binance-trader/app/backend
ExecStart=/opt/binance-trader/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8100
Restart=always
RestartSec=5
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/binance-trader

[Install]
WantedBy=multi-user.target
